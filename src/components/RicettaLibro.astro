---
import { render } from 'astro:content';
import FotoPassaggioLibro from './FotoPassaggioLibro.astro';
import {
  formattaData,
  formattaDose,
  formattaDurata,
  formattaPorzioni,
  tempoTotale,
} from '../lib/formato';
import { mappaAutori, risolviContributori, type Ricetta } from '../lib/ricettario';
import { storiaRicetta } from '../lib/storia';

interface Props {
  ricetta: Ricetta;
  autore: string;
}

const { ricetta, autore } = Astro.props;
const d = ricetta.data;
const { Content } = await render(ricetta);
const storia = storiaRicetta(ricetta.id);
const autoriPerId = await mappaAutori();
const contributori = await risolviContributori(storia.contributori);

// Come sul sito: la nota legata a un passaggio si legge sotto quel passaggio, dove serve
// davvero; in fondo restano solo quelle sulla ricetta nel suo insieme.
const contributi = d.contributi
  .filter((c) => c.passaggio === undefined)
  .sort((a, b) => b.data.getTime() - a.data.getTime());

const notePerPassaggio = (numero: number) =>
  d.contributi.filter((c) => c.passaggio === numero);

const dati = [
  { etichetta: 'Porzioni', valore: formattaPorzioni(d.porzioni, d.unitaPorzioni) },
  { etichetta: 'Preparazione', valore: formattaDurata(d.tempoPreparazione) },
  ...(d.tempoCottura > 0 ? [{ etichetta: 'Cottura', valore: formattaDurata(d.tempoCottura) }] : []),
  ...(d.tempoRiposo > 0 ? [{ etichetta: 'Riposo', valore: formattaDurata(d.tempoRiposo) }] : []),
  { etichetta: 'Totale', valore: formattaDurata(tempoTotale(d)) },
  { etichetta: 'Difficoltà', valore: d.difficolta },
];
---

<article class="ricetta-libro" id={`ric-${ricetta.id}`}>
  <h3 class="titolo-ricetta">{d.titolo}</h3>
  <p class="firma">di {autore}</p>
  {d.descrizione && <p class="occhiello-ricetta">{d.descrizione}</p>}

  <dl class="dati-libro">
    {
      dati.map((v) => (
        <div>
          <dt>{v.etichetta}</dt>
          <dd>{v.valore}</dd>
        </div>
      ))
    }
  </dl>

  <section class="riquadro-libro">
    <h4>Ingredienti</h4>
    {
      d.ingredienti.map((gruppo) => (
        <div class="gruppo-libro">
          {gruppo.gruppo && <h5>{gruppo.gruppo}</h5>}
          <ul class="lista-ingredienti">
            {gruppo.voci.map((voce) => (
              <li>
                <span>
                  {voce.nome}
                  {voce.note && <span class="nota-ing">{voce.note}</span>}
                </span>
                <span class="dose">{formattaDose(voce.quantita, voce.unita)}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  {
    d.accessori.length > 0 && (
      <section class="riquadro-libro">
        <h4>Occorrente</h4>
        <ul class="lista-accessori">
          {d.accessori.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      </section>
    )
  }

  <ol class="passaggi-libro">
    {
      d.passaggi.map((p, i) => (
        <li>
          <div>
            {p.titolo && <h5>{p.titolo}</h5>}
            <p>{p.testo}</p>
            {p.durata !== undefined && p.durata > 0 && (
              <span class="durata-passo">{formattaDurata(p.durata)}</span>
            )}
            {p.foto && (
              <FotoPassaggioLibro
                foto={p.foto}
                didascalia={p.didascalia}
                numero={i + 1}
                titoloRicetta={d.titolo}
              />
            )}

            {notePerPassaggio(i + 1).map((c) => (
              <p class="nota-passo-libro">
                {c.testo}
                <span class="contributo-firma">
                  {autoriPerId.get(c.autore.id)?.data.nome ?? c.autore.id} · {formattaData(c.data)}
                </span>
              </p>
            ))}
          </div>
        </li>
      ))
    }
  </ol>

  {
    d.conservazione && (
      <p class="note-libro">
        <strong>Conservazione</strong>
        {d.conservazione}
      </p>
    )
  }

  {
    d.note && (
      <p class="note-libro">
        <strong>Note</strong>
        {d.note}
      </p>
    )
  }

  {
    contributi.length > 0 && (
      <section class="contributi-libro">
        <h4>Contributi</h4>
        <ol>
          {contributi.map((c) => (
            <li>
              <span class="contributo-testo">{c.testo}</span>
              <span class="contributo-firma">
                {autoriPerId.get(c.autore.id)?.data.nome ?? c.autore.id} · {formattaData(c.data)}
              </span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <div class="corpo-libero">
    <Content />
  </div>

  <p class="pie-ricetta">
    {d.fonte && <>Fonte: {d.fonte}. </>}
    {
      storia.revisione > 0 && (
        <>
          Revisione {storia.revisione}
          {storia.ultima && <>, aggiornata il {formattaData(storia.ultima)}</>}
          {contributori.length > 0 && <> · {contributori.join(', ')}</>}
        </>
      )
    }
  </p>
</article>
