---
import FotoPassaggio from './FotoPassaggio.astro';
import { formattaData, formattaDurata } from '../lib/formato';
import { mappaAutori, type Ricetta } from '../lib/ricettario';

interface Props {
  ricetta: Ricetta;
  titolo?: string;
}

const { ricetta, titolo = 'Preparazione' } = Astro.props;
const passaggi = ricetta.data.passaggi;
const autori = await mappaAutori();

/** Le note che qualcuno ha lasciato su un passaggio preciso, sotto quel passaggio. */
const notePerPassaggio = (numero: number) =>
  ricetta.data.contributi.filter((c) => c.passaggio === numero);
---

<section class="blocco-passaggi">
  {titolo && <h2>{titolo}</h2>}
  <ol class="passaggi">
    {
      passaggi.map((p, i) => (
        <li>
          <div>
            {p.titolo && <h3>{p.titolo}</h3>}
            <p>{p.testo}</p>
            {p.durata !== undefined && p.durata > 0 && (
              <span class="durata">⏱ {formattaDurata(p.durata)}</span>
            )}
            {p.foto && (
              <FotoPassaggio
                foto={p.foto}
                didascalia={p.didascalia}
                numero={i + 1}
                titoloRicetta={ricetta.data.titolo}
              />
            )}

            {notePerPassaggio(i + 1).map((c) => (
              <aside class="nota-passaggio">
                <p>{c.testo}</p>
                <p class="nota-passaggio__firma">
                  {autori.get(c.autore.id)?.data.nome ?? c.autore.id} · {formattaData(c.data)}
                </p>
              </aside>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</section>
