{
  "name": "ricettario-marano",
  "version": "0.2.0",
  "description": "Il ricettario della famiglia Marano: sito navigabile e libro PDF stampabile.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "pdf": "astro build && node scripts/genera-pdf.mjs",
    "pdf:solo": "node scripts/genera-pdf.mjs",
    "versione": "node scripts/calcola-versione.mjs",
    "versione:applica": "node scripts/calcola-versione.mjs --applica",
    "rimuovi-esempi": "node scripts/rimuovi-esempi.mjs",
    "rimuovi-esempi:conferma": "node scripts/rimuovi-esempi.mjs --conferma",
    "rilascio": "node scripts/calcola-versione.mjs --applica && npm run pdf"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "astro": "^5.13.0",
    "pagedjs": "^0.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
